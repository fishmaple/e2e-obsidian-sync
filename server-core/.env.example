PORT=8787
DATA_DIR=./data
SESSION_SECRET=

# central：可注册的集中式服务器，登录后得到账户 ID
# single：单账户服务器，免注册，启动后下发固定账户 ID
SERVER_MODE=central

# 留空时，集中式默认必须加密，单账户默认允许明文
# true 拒绝明文上传，false 允许插件关闭加密
REQUIRE_ENCRYPTION=

# 单账户模式可选。设置后，打开页面和获取账户 ID 需要这个口令
ACCESS_TOKEN=

# 留空则使用 DATA_DIR/sync.db
# sqlite:./sync.db
# postgres://user:pass@127.0.0.1:5432/obsidian_sync
# mysql://user:pass@127.0.0.1:3306/obsidian_sync
DATABASE_URL=

# file | database | qiniu | r2
# r2 把小于 BLOB_INLINE_MAX_BYTES 的正文留在数据库，其余放到 Cloudflare R2。
# 数据库和本地文件仍然是完整存储方式。切换 STORAGE 后，启动时会把已有正文迁到新位置。
STORAGE=file
# https://<account>.r2.cloudflarestorage.com 或带桶名的路径
R2_ENDPOINT=
R2_BUCKET=
# 二选一：Cloudflare 用户令牌，或 S3 访问密钥对。不要把真实值提交到仓库。
R2_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BLOB_INLINE_MAX_BYTES=128
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=https://cdn.example.com
# z0 华东，z1 华北，z2 华南，na0 北美，as0 东南亚，cn-east-2 华东二区
QINIU_ZONE=z0
QINIU_PRIVATE=true
QINIU_RS_URL=https://rs.qiniu.com

# 集中式服务器的 SSO。四个都填上后，登录页出现「使用 SSO 登录」
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8787/auth/oidc/callback
# 未配置 SSO 时默认开启开发登录。配置了 SSO 后，只有设为 true 才保留
ALLOW_DEV_LOGIN=
