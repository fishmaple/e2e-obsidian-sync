{
  "name": "server-core",
  "description": "Open-source self-hosted sync server. Start it on its own with npm run dev or npm start.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/app.test.ts src/config.test.ts ../shared/src/crypto.test.ts ../shared/src/merge.test.ts ../shared/src/reconcile.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "hono": "^4.10.3",
    "jose": "^6.1.0",
    "mysql2": "^3.15.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
